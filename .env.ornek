# ─────────────────────────────────────────────────────────────
#  Ödeme Takip — ayar dosyası
#  Bu dosyayı ".env" adıyla kopyalayıp değerleri doldurun.
#  (Zaten .env varsa oradan devam edin — bu dosya sadece örnektir.)
# ─────────────────────────────────────────────────────────────

# --- Web arayüzü ---
# Yalnızca bu bilgisayardan erişilsin: 127.0.0.1
# Aynı ağdaki telefondan/tabletten de erişmek isterseniz: 0.0.0.0
HOST=127.0.0.1
PORT=3400

# --- Telegram botu ---
# 1) Telegram'da @BotFather'a yazın → /newbot → size bir token verir.
# 2) Token'ı aşağıya yapıştırın.
# 3) Botunuza Telegram'dan bir mesaj yazın, sonra tarayıcıda açın:
#    https://api.telegram.org/bot<TOKEN>/getUpdates  →  "chat":{"id": ...} değerini buraya yazın.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Fiş okuma ---
# PDF dekontlar (bankadan indirilen / e-postayla gelen) YEREL olarak okunur: anahtar gerekmez.
# Aşağıdaki anahtar YALNIZCA fotoğraf / ekran görüntüsü okumak için gereklidir.
# İsterseniz boş bırakın; sistem çalışır, sadece fotoğraf okunamaz.
OPENROUTER_API_KEY=
# Fotoğraf okumada kullanılacak görsel (vision) modeli
VISION_MODEL=google/gemini-4-neon

# --- Bildirim ---
# Günlük bildirimin gönderileceği saat (yerel saat)
BILDIRIM_SAATI=09:00

# --- Diğer ---
TZ=Europe/Istanbul
# Veritabanı ve fiş görsellerinin yeri (boşsa uygulama klasörü kullanılır)
# DB_PATH=
# FIS_KLASOR=
